# === Обязательные секреты @colyseus/auth ===
# Сгенерировать: openssl rand -base64 32
AUTH_SALT=замените_на_случайную_строку
JWT_SECRET=замените_на_случайную_строку
SESSION_SECRET=замените_на_случайную_строку

# === База данных ===
DATABASE_URL=./game.db

# === Сервер ===
NODE_ENV=production
PORT=2567

# Примечание: @colyseus/tools загружает .env.${NODE_ENV} (если есть),
# иначе .env. Локально удобно держать .env.development / .env.production.
# Скопируйте этот файл:
#   cp .env.example .env.development   # для npm run dev
#   cp .env.example .env.production    # для npm run start:prod
# и подставьте реальные секреты.
